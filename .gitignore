# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
# 但这两个是我们手写并维护的打包配置，必须提交
!packaging/windows/ClassManageSystem.spec
!packaging/macos/ClassManageSystem.spec
# 构建时由 spec 生成的版本信息（内容来自 about_dialog.VERSION）
packaging/windows/version_info.generated.txt

